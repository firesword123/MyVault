{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyVault Gallery",
  "version": "0.1.13",
  "identifier": "com.facial.myvault.gallery",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../icons/32x32.png", "../icons/icon.ico"]
  }
}
