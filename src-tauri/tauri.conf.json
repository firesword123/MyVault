{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyVault",
  "version": "0.1.15",
  "identifier": "com.facial.myvault",
  "build": {
    "beforeDevCommand": "npm run tauri:before-dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:before-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyVault",
        "width": 1093,
        "height": 771,
        "x": 179,
        "y": 49,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "target/sidecars/myvault-dl-asmr",
      "target/sidecars/myvault-gallery"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwOTVBNjQyNEIwMDlERApSV1RkQ2JBa1pGb0pBeVp1MUZyYXcvaTJ6K3ZyYUhXUFBMTWhsNmFYejJkQWpKNERpR05JUHdHawo=",
      "endpoints": [
        "https://github.com/firesword123/MyVault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
