{
  "name": "myvault",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:asmr": "powershell -ExecutionPolicy Bypass -File scripts/build-asmr-sidecar.ps1",
    "asmr:agent": "powershell -ExecutionPolicy Bypass -File src-tauri/asmr/agent.ps1",
    "prepare:gallery": "powershell -ExecutionPolicy Bypass -File scripts/build-gallery-sidecar.ps1",
    "prepare:modules": "npm run prepare:asmr && npm run prepare:gallery",
    "tauri:before-dev": "npm run prepare:modules && npm run dev",
    "tauri:before-build": "npm run build && npm run prepare:asmr -- -Release && npm run prepare:gallery -- -Release",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:update": "powershell -ExecutionPolicy Bypass -File scripts/build-updater-release.ps1",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:smoke": "powershell -ExecutionPolicy Bypass -File scripts/acceptance-smoke.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
